#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context. An explicit --brief file is used as the
# selected task's brief after its plan path, revision, task ID and bytes are
# verified against the plan.
#
# Usage: task-brief PLAN_FILE TASK_ID [OUTFILE] [--brief FILE]
# Default OUTFILE: <repo-root>/.baspowers/sdd/<plan-basename>/task-<ID>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it). With --brief, the default is the explicit
# workspace keyed by the plan's canonical path and the brief's revision.
set -euo pipefail

die() {
  echo "task-brief: $*" >&2
  exit 2
}

usage() {
  echo "usage: task-brief PLAN_FILE TASK_ID [OUTFILE] [--brief FILE]" >&2
  exit 2
}

brief=
pos=()
while [ $# -gt 0 ]; do
  case "$1" in
    --brief)
      [ $# -ge 2 ] || usage
      brief=$2
      shift 2
      ;;
    -*)
      echo "unknown option: $1" >&2
      usage
      ;;
    *)
      pos+=("$1")
      shift
      ;;
  esac
done

if [ ${#pos[@]} -lt 2 ] || [ ${#pos[@]} -gt 3 ]; then
  usage
fi

plan=${pos[0]}
n=${pos[1]}
case "$n" in
  '' | *[!A-Za-z0-9._-]*) die "task ID '$n' must contain only letters, digits, '.', '_' or '-'" ;;
esac
user_out=
if [ ${#pos[@]} -eq 3 ]; then
  user_out=${pos[2]}
fi
[ -f "$plan" ] || die "no such plan file: $plan"

sdd="$(cd "$(dirname "$0")" && pwd)/sdd-workspace"

abs_file() {
  local dir
  dir=$(CDPATH='' cd -- "$(dirname "$1")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$dir" "$(basename "$1")"
}

plan_abs=$(abs_file "$plan") || die "cannot resolve plan path: $plan"
root=$(CDPATH='' cd -- "$(git rev-parse --show-toplevel)" 2>/dev/null && pwd -P) || root=

ws_args=("$sdd" "$plan")
brief_abs=
if [ -n "$brief" ]; then
  [ -f "$brief" ] || die "no such brief file: $brief"
  brief_abs=$(abs_file "$brief") || die "cannot resolve brief path: $brief"
  ws_args+=(--brief "$brief" --task "$n")
fi

if [ -n "$brief" ] || [ -z "$user_out" ]; then
  # Resolving the workspace also validates an explicit brief. Do it before
  # any output path is created, so a rejected brief leaves no empty file.
  dir=$("${BASH:-bash}" "${ws_args[@]}")
else
  dir=
fi

if [ -n "$user_out" ]; then
  out=$user_out
else
  out="$dir/task-${n}-brief.md"
fi

[ ! -L "$out" ] || die "refusing symlink output: $out"
out_abs=$(abs_file "$out") || die "cannot resolve output path: $out"
[ "$out_abs" != "$plan_abs" ] || die "refusing to write the plan file: $out"

# A user-chosen path may not overwrite a tracked file. Default outputs live
# in the git-ignored workspace and are scratch by construction.
if [ -n "$root" ]; then
  case "$out_abs" in
    "$root"/*)
      rel=${out_abs#"$root"/}
      if git -C "$root" ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
        die "refusing to overwrite tracked file: $out (choose scratch)"
      fi
      ;;
  esac
fi

tmpout=$(mktemp "${out}.XXXXXX")
trap 'rm -f -- "$tmpout"' EXIT

if [ -n "$brief" ]; then
  # The explicit brief is already the selected task's text. Copy it into
  # scratch unless the caller already pointed at that exact file, and keep
  # the input bytes untouched either way.
  if [ "$out_abs" != "$brief_abs" ]; then
    cat "$brief_abs" > "$tmpout"
    mv -f -- "$tmpout" "$out"
  fi
  [ -s "$out" ] || die "copied brief is empty: $out"
  lines=$(awk 'END { print NR }' "$out")
  echo "wrote ${out}: ${lines} lines"
  exit 0
fi

# Legacy Task extraction. A Markdown fence opens or closes only at columns
# 0-3, so arbitrarily indented ``` text is content. Fenced text never supplies
# a heading; headings deeper than the selected task stay in its body; a
# missing final newline still emits the last line. Non-Task headings never end
# a task. Numeric task headings keep their old non-digit delimiters, so
# "Task 1.", "Task 1—Name" and "Task 1)" all select Task 1.
TASK_ID=$n awk '
  BEGIN {
    target = ENVIRON["TASK_ID"]
    intask = 0
    infence = 0
    task_level = 0
    numeric = (target ~ /^[0-9]+$/)
  }
  function emit() { if (intask) print }
  function matches(rest,   word, following) {
    word = rest
    sub(/[ \t].*$/, "", word)
    if (word == target || word == target ":") return 1
    if (numeric && index(word, target) == 1) {
      following = substr(word, length(target) + 1, 1)
      if (following != "" && following !~ /^[0-9]$/) return 1
    }
    return 0
  }
  {
    line = $0
    sub(/\r$/, "", line)
    if (match(line, /^ {0,3}```+/) || match(line, /^ {0,3}~~~+/)) {
      marker = substr(line, RSTART, RLENGTH)
      rest = substr(line, RSTART + RLENGTH)
      sub(/^[ \t]+/, "", marker)
      ch = substr(marker, 1, 1)
      len = length(marker)
      if (!infence) {
        infence = 1
        fence_ch = ch
        fence_len = len
      } else if (ch == fence_ch && len >= fence_len && rest ~ /^[ \t]*$/) {
        infence = 0
      }
      emit()
      next
    }
    if (!infence && match(line, /^[ \t]*#+[ \t]+Task[ \t]+/)) {
      rest = substr(line, RSTART + RLENGTH)
      hdr = substr(line, 1, RSTART + RLENGTH - 1)
      match(hdr, /#+/)
      level = RLENGTH
      if (matches(rest)) {
        if (!intask || level <= task_level) {
          intask = 1
          task_level = level
        }
        print
        next
      }
      if (intask && level <= task_level) {
        intask = 0
        next
      }
      emit()
      next
    }
    emit()
  }
' "$plan" > "$tmpout"

if [ ! -s "$tmpout" ]; then
  rm -f "$tmpout"
  trap - EXIT
  if grep -Eqi '^[[:space:]]*#+[[:space:]]+(phase|stage)[[:space:]]' "$plan"; then
    echo "task ${n} not found in ${plan}: this is a phase plan, not a task plan; select one bounded task and pass --brief FILE" >&2
  else
    echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  fi
  exit 3
fi

mv "$tmpout" "$out"
trap - EXIT
echo "wrote ${out}: $(awk 'END { print NR }' "$out") lines"
